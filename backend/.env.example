# .env — Aura Player backend configuration
# Copy this file to .env and adjust values for your environment.
# All variables are optional — the defaults work for local development.

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Set absolute paths if ffmpeg/ffprobe are not on your PATH
# AURA_FFMPEG_PATH=/usr/local/bin/ffmpeg
# AURA_FFPROBE_PATH=/usr/local/bin/ffprobe

# How long to wait for a single FFprobe invocation (seconds)
AURA_FFPROBE_TIMEOUT=15

# Maximum wall-clock seconds a single FFmpeg remux/transcode job may run
# before it is killed. 300 s = 5 minutes (covers most remux jobs).
AURA_FFMPEG_JOB_TIMEOUT=300

# Maximum concurrent FFmpeg transcode/remux jobs
AURA_FFMPEG_MAX_JOBS=4

# H.264 quality (lower = better quality, larger file). 18=near-lossless, 28=fast
AURA_TRANSCODE_CRF=23

# x264 preset. Options: ultrafast superfast veryfast faster fast medium slow
AURA_TRANSCODE_PRESET=veryfast

# ── Storage ───────────────────────────────────────────────────────────────────
# Where remuxed/transcoded files are stored temporarily
# AURA_TEMP_DIR=/tmp/aura_player

# Soft storage budget in MB: old files are pruned *before* each new job starts.
# This is NOT a hard real-time cap. With AURA_FFMPEG_MAX_JOBS=4 concurrent jobs,
# actual disk usage can temporarily exceed this value by up to
# (ffmpeg_max_jobs × largest_single_output). Set conservatively.
AURA_MAX_TEMP_SIZE_MB=2048

# How long remuxed files are cached before eviction (seconds)
AURA_REMUX_CACHE_TTL=600

# ── HTTP ──────────────────────────────────────────────────────────────────────
AURA_HTTP_TIMEOUT=10
AURA_MAX_REDIRECTS=5

# ── Security ──────────────────────────────────────────────────────────────────
# Set to false only in trusted internal environments
AURA_BLOCK_PRIVATE_IPS=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# AURA_CORS_ORIGINS=["http://localhost:5173","https://yourdomain.com"]

# ── Trusted hosts ─────────────────────────────────────────────────────────────
# Host header allow-list. Defaults to ["*"] (accept any Host) for local dev.
# In production, set this to your real API domain(s) to reject requests that
# arrive with a forged/unexpected Host header.
# AURA_TRUSTED_HOSTS=["api.yourdomain.com"]

# ── Streaming ─────────────────────────────────────────────────────────────────
# Chunk size for HTTP streaming responses (bytes)
AURA_STREAM_CHUNK_SIZE=524288

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Per-IP request limits for expensive endpoints. Format: "N/period"
# Periods: second, minute, hour, day. Set AURA_RATE_LIMIT_ENABLED=false to
# disable entirely (development only).
AURA_RATE_LIMIT_ENABLED=true
AURA_RATE_LIMIT_PROBE=30/minute
AURA_RATE_LIMIT_PLAY=30/minute
AURA_RATE_LIMIT_PROXY_SESSION=20/minute
AURA_RATE_LIMIT_REMUX=10/minute
AURA_RATE_LIMIT_RTMP=10/minute

# ── Multi-worker deployment note ─────────────────────────────────────────────
# The rate limiter and FFmpeg job-dedup table use in-process memory.
# With multiple uvicorn workers (--workers N > 1), each worker has independent
# state, which means:
#   • Rate limit counters are per-worker (effective limit ≈ N × configured limit)
#   • Duplicate FFmpeg jobs can be launched for the same URL by different workers
#   • Storage budget check is per-worker (burst can be N × single-job overshoot)
# For multi-worker production, use Redis-backed rate limiting and a shared job
# queue (e.g. Celery/ARQ). Single-worker deployments are unaffected.
